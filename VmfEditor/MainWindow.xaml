<Window x:Class="VmfEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VmfEditor"
        Title="TDU2 VMF Editor" Height="900" Width="1500" Background="{StaticResource Bg}" Foreground="{StaticResource Fg}">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{x:Static local:MainWindow.OpenCmd}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{x:Static local:MainWindow.SaveCmd}"/>
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{x:Static local:MainWindow.UndoCmd}"/>
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{x:Static local:MainWindow.RedoCmd}"/>
        <KeyBinding Key="F4" Command="{x:Static local:MainWindow.ScriptsCmd}"/>
    </Window.InputBindings>
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="{StaticResource Panel}" Foreground="{StaticResource Fg}">
            <MenuItem Header="_File" Foreground="{StaticResource Fg}">
                <MenuItem Header="Open bank…" InputGestureText="Ctrl+O" Command="{x:Static local:MainWindow.OpenCmd}" Foreground="Black"/>
                <MenuItem Header="Save" InputGestureText="Ctrl+S" Command="{x:Static local:MainWindow.SaveCmd}" Foreground="Black"/>
                <Separator/>
                <MenuItem Header="Exit" Click="Exit_Click" Foreground="Black"/>
            </MenuItem>
            <MenuItem Header="_Edit" Foreground="{StaticResource Fg}">
                <MenuItem Header="Undo" InputGestureText="Ctrl+Z" Command="{x:Static local:MainWindow.UndoCmd}" Foreground="Black"/>
                <MenuItem Header="Redo" InputGestureText="Ctrl+Y" Command="{x:Static local:MainWindow.RedoCmd}" Foreground="Black"/>
                <Separator/>
                <MenuItem Header="ActionScript…" InputGestureText="F4" Command="{x:Static local:MainWindow.ScriptsCmd}" Foreground="Black"/>
            </MenuItem>
        </Menu>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="8,3">
            <TextBlock x:Name="Status" Text="Open a bank (Ctrl+O): Euro\Bnk\frontend\hires\*.bnk" Foreground="{StaticResource Dim}"/>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>
            <!-- Left: timelines/sprites -->
            <TabControl x:Name="LeftTabs" Grid.Column="0" Background="{StaticResource Panel}" BorderThickness="0" Padding="0">
                <TabItem Header="Library">
                    <DockPanel Background="{StaticResource Panel}">
                        <TextBox x:Name="Filter" DockPanel.Dock="Top" Margin="6" TextChanged="Filter_TextChanged" ToolTip="Filter sprites (id, instance or export name)"/>
                        <TreeView x:Name="Tree" SelectedItemChanged="Tree_SelectedItemChanged"/>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Layers">
                    <DockPanel Background="{StaticResource Panel}">
                        <DockPanel DockPanel.Dock="Top" Margin="6">
                            <Button Content="Reset view" DockPanel.Dock="Right" Click="ResetView_Click" ToolTip="Show all elements again and use the automatic frame for every sprite"/>
                            <TextBlock Text="Untick to hide (editor view only, not saved to the bank)" TextWrapping="Wrap" Foreground="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TreeView x:Name="Layers" SelectedItemChanged="Layers_SelectedItemChanged"/>
                    </DockPanel>
                </TabItem>
            </TabControl>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource Line}"/>
            <!-- Center: stage -->
            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="4">
                    <DockPanel LastChildFill="True">
                        <Button x:Name="BackBtn" Content="◀ Back" Click="Back_Click" IsEnabled="False" ToolTip="Back to the parent timeline"/>
                        <TextBlock x:Name="Crumb" VerticalAlignment="Center" Margin="6,0" Text="–" MinWidth="120"/>
                        <TextBlock Text="Label" VerticalAlignment="Center" Margin="10,0,4,0" Foreground="{StaticResource Dim}"/>
                        <ComboBox x:Name="LabelBox" Width="150" SelectionChanged="LabelBox_SelectionChanged"/>
                        <TextBlock Text="Frame" VerticalAlignment="Center" Margin="10,0,4,0" Foreground="{StaticResource Dim}"/>
                        <TextBlock x:Name="FrameText" VerticalAlignment="Center" Width="70" Text="1 / 1"/>
                        <CheckBox x:Name="VarsBox" Content="Variables" IsChecked="True" Click="View_Click" ToolTip="Show empty text fields with their variable name"/>
                        <CheckBox x:Name="BoundsBox" Content="Bounds" Click="View_Click" ToolTip="Show bounds of all elements"/>
                        <Button Content="Fit" Click="Fit_Click" DockPanel.Dock="Right"/>
                        <Button x:Name="PlayBtn" Content="▶ Play" Click="Play_Click" DockPanel.Dock="Right" ToolTip="Play the timeline and nested animations (scripts are not executed). When paused, every nested sprite shows its stop() frame with the most content (menus are often only revealed by script)."/>
                        <Slider x:Name="FrameSlider" Minimum="0" Maximum="0" IsSnapToTickEnabled="True" TickFrequency="1" Margin="8,0" VerticalAlignment="Center" ValueChanged="FrameSlider_ValueChanged"/>
                    </DockPanel>
                </Border>
                <local:StageView x:Name="Stage"/>
            </DockPanel>
            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="{StaticResource Line}"/>
            <!-- Right: properties -->
            <ScrollViewer Grid.Column="4" Background="{StaticResource Panel}" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Props" Margin="10"/>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
