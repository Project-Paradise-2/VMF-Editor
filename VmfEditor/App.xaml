<Application x:Class="VmfEditor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#1E1F22"/>
        <SolidColorBrush x:Key="Panel" Color="#2B2D30"/>
        <SolidColorBrush x:Key="Line" Color="#3C3F44"/>
        <SolidColorBrush x:Key="Fg" Color="#DFE1E5"/>
        <SolidColorBrush x:Key="Dim" Color="#8C9096"/>
        <SolidColorBrush x:Key="Accent" Color="#4A9EFF"/>
        <!-- Kein globaler TextBlock-Stil: er würde auch die hellen System-Klapplisten/Menüs mit heller Schrift füllen.
             Die Fensterschrift kommt über Window.Foreground. -->
        <Style TargetType="Label"><Setter Property="Foreground" Value="{StaticResource Fg}"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Fg}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="6,0"/></Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E1F22"/><Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="CaretBrush" Value="{StaticResource Fg}"/>
            <Setter Property="Padding" Value="3,2"/>
        </Style>
        <!-- Buttons und Tabs mit eigener Vorlage, damit sie zum dunklen Design passen (Windows-Vorlage ignoriert die Farben) -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3C3F44"/><Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="BorderBrush" Value="#4E5157"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,3"/><Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#4A4E55"/><Setter TargetName="Bd" Property="BorderBrush" Value="#4A9EFF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#2F6FB8"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#4A9EFF"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#6A6E74"/><Setter TargetName="Bd" Property="Background" Value="#2E3034"/><Setter TargetName="Bd" Property="BorderBrush" Value="#3C3F44"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel Background="{TemplateBinding Background}">
                            <Border DockPanel.Dock="Top" Background="#25272A" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True" Background="Transparent"/>
                            </Border>
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="14,6" Cursor="Hand">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Fg}"/><Setter TargetName="Bd" Property="Background" Value="#33363B"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource Fg}"/><Setter TargetName="Bd" Property="BorderBrush" Value="#4A9EFF"/><Setter TargetName="Bd" Property="Background" Value="#33363B"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TreeView"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{StaticResource Fg}"/></Style>
        <!-- Klappliste bleibt hell (Systemvorlage): dunkle Schrift darin -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="Black"/></Style>
        <Style TargetType="MenuItem"><Setter Property="Foreground" Value="Black"/></Style>
        <Style TargetType="TreeViewItem"><Setter Property="Foreground" Value="{StaticResource Fg}"/></Style>
    </Application.Resources>
</Application>
